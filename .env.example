# Copy this file to .env.local for local development only.
# Never commit .env.local or replace these placeholders in this file.

# API server
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/postgres?sslmode=require
# Use a direct, TLS-required connection for reviewed migration commands only.
DATABASE_MIGRATION_URL=postgresql://MIGRATION_USER:MIGRATION_PASSWORD@DIRECT_DATABASE_HOST:5432/postgres?sslmode=require
SUPABASE_PROJECT_ID=qulqcuuzncyyszgdpfad
SUPABASE_URL=https://qulqcuuzncyyszgdpfad.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
FOUNDER_MOHANNAD_USER_ID=YOUR_MOHANNAD_SUPABASE_AUTH_UUID
FOUNDER_MOAYAD_USER_ID=YOUR_MOAYAD_SUPABASE_AUTH_UUID
VAULT_ENCRYPTION_KEY=YOUR_LOCAL_64_CHARACTER_HEXADECIMAL_KEY
# Public, pinned Manifest V3 extension ID. This is not a secret.
VAULT_EXTENSION_ID=mfhbbeeolmdfojdfenemmnehkagboeoo

# Vite web application
# The web dev server uses its own PORT value when launched; see docs/local-development.md.
BASE_PATH=/
VITE_SUPABASE_PROJECT_ID=qulqcuuzncyyszgdpfad
VITE_SUPABASE_URL=https://qulqcuuzncyyszgdpfad.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
LOCAL_API_URL=http://127.0.0.1:3001
